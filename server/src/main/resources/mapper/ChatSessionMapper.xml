<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.java1234.mapper.ChatSessionMapper">

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_chat_session (user_id, title)
        VALUES (#{userId}, #{title})
    </insert>

    <update id="updateTitle">
        UPDATE t_chat_session SET title = #{title}, update_time = NOW() WHERE id = #{id}
    </update>

    <update id="touchUpdateTime">
        UPDATE t_chat_session SET update_time = NOW() WHERE id = #{id}
    </update>

    <select id="selectById" resultType="com.java1234.entity.ChatSession">
        SELECT * FROM t_chat_session WHERE id = #{id}
    </select>

    <select id="listByUserId" resultType="com.java1234.entity.ChatSession">
        SELECT * FROM t_chat_session WHERE user_id = #{userId} ORDER BY update_time DESC, id DESC
    </select>

    <delete id="deleteById">
        DELETE FROM t_chat_session WHERE id = #{id}
    </delete>
</mapper>
