<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.java1234.mapper.DepartmentMapper">

    <select id="listAll" resultType="com.java1234.entity.Department">
        SELECT * FROM t_department ORDER BY id ASC
    </select>

    <select id="selectById" resultType="com.java1234.entity.Department">
        SELECT * FROM t_department WHERE id = #{id}
    </select>

    <select id="selectByName" resultType="com.java1234.entity.Department">
        SELECT * FROM t_department WHERE name = #{name}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_department (name, remark)
        VALUES (#{name}, #{remark})
    </insert>

    <update id="update">
        UPDATE t_department
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="remark != null">remark = #{remark},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM t_department WHERE id = #{id}
    </delete>
</mapper>
